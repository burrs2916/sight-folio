{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sight Folio",
  "version": "0.1.0",
  "identifier": "com.sight.folio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:23010",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sight Folio",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' data:; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; media-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:23010 http://localhost:23010 blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$APPDATA/**",
          "$EXE/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "$HOME/GithubProSpace/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {},
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
